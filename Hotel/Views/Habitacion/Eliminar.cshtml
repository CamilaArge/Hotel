@model Habitacion

@{
    ViewData["Title"] = "Eliminar habitación";
    bool bloqueada = ViewBag.Bloqueada == true;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card ht-card shadow-sm">
            <div class="card-header">
                @(bloqueada ? "No se puede eliminar esta habitación" : "¿Seguro que desea eliminar esta habitación?")
            </div>
            <div class="card-body p-4">
                <partial name="_Mensajes" />
                <partial name="_DatosHabitacion" model="Model" />
            </div>
            <div class="card-footer bg-white">
                @if (!bloqueada)
                {
                    <form asp-action="Eliminar" asp-route-id="@Model.IdHabitacion" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </form>
                }
                else
                {
                    <a asp-action="Editar" asp-route-id="@Model.IdHabitacion" class="btn btn-warning">Ir a Editar</a>
                }
                <a asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
