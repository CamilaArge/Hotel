@model Habitacion

@{
    ViewData["Title"] = "Agregar habitación";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card ht-card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-3">Agregar habitación</h3>

                <partial name="_Mensajes" />

                <form asp-action="AgregarHabitacion" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CodigoDeHabitacion" class="form-label"></label>
                            <input asp-for="CodigoDeHabitacion" class="form-control" />
                            <span asp-validation-for="CodigoDeHabitacion" class="text-danger"></span>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label asp-for="NombreDeHabitacion" class="form-label"></label>
                            <input asp-for="NombreDeHabitacion" class="form-control" />
                            <span asp-validation-for="NombreDeHabitacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CantidadHuespedesPermitidos" class="form-label"></label>
                            <input asp-for="CantidadHuespedesPermitidos" class="form-control" />
                            <span asp-validation-for="CantidadHuespedesPermitidos" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CantidadCamas" class="form-label"></label>
                            <input asp-for="CantidadCamas" class="form-control" />
                            <span asp-validation-for="CantidadCamas" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CantidadDeBanos" class="form-label"></label>
                            <input asp-for="CantidadDeBanos" class="form-control" />
                            <span asp-validation-for="CantidadDeBanos" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Ubicacion" class="form-label"></label>
                            <input asp-for="Ubicacion" class="form-control" />
                            <span asp-validation-for="Ubicacion" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CostoDeReserva" class="form-label"></label>
                            <input asp-for="CostoDeReserva" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="CostoDeReserva" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="TipoDeHabitacion" class="form-label"></label>
                            <select asp-for="TipoDeHabitacion" class="form-select">
                                <option value="0">Seleccione tipo</option>
                                <option value="1">Junior</option>
                                <option value="2">Superior</option>
                                <option value="3">Suite</option>
                            </select>
                            <span asp-validation-for="TipoDeHabitacion" class="text-danger"></span>
                        </div>

                      
                    </div>

                    <button type="submit" class="btn btn-success">Guardar</button>
                    <a asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
