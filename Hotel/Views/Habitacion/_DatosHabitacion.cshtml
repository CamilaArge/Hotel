@model Habitacion

<dl class="row mb-0">
    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Codigo)</dt>
    <dd class="col-sm-8">@Model.Codigo</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-8">@Model.Nombre</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-8">@Model.Descripcion</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IdTipoHabitacion)</dt>
    <dd class="col-sm-8">@Model.TipoTexto</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CantidadHuespedes)</dt>
    <dd class="col-sm-8">@Model.CantidadHuespedes</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CantidadCamas)</dt>
    <dd class="col-sm-8">@Model.CantidadCamas</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CantidadBanos)</dt>
    <dd class="col-sm-8">@Model.CantidadBanos</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Ubicacion)</dt>
    <dd class="col-sm-8">@Model.Ubicacion</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.PrecioPorNoche)</dt>
    <dd class="col-sm-8">@Model.PrecioPorNoche.Colones()</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.EstadoOperativo)</dt>
    <dd class="col-sm-8"><partial name="_EstadoBadge" model="Model.EstadoOperativo" /></dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
    <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaModificacion)</dt>
    <dd class="col-sm-8">@(Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
</dl>
