@model Habitacion

@{
    ViewData["Title"] = "Detalles de habitación";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card ht-card shadow-sm">
            <div class="card-header">Detalles de la habitación</div>
            <div class="card-body p-4">
                <partial name="_DatosHabitacion" model="Model" />
            </div>
            <div class="card-footer bg-white">
                @if (User.IsInRole(Roles.Administrador))
                {
                    <a asp-action="Editar" asp-route-id="@Model.IdHabitacion" class="btn btn-warning">Editar</a>
                }
                <a asp-action="ActualizarEstado" asp-route-id="@Model.IdHabitacion" class="btn btn-outline-dark">Actualizar estado</a>
                <a asp-controller="Reserva" asp-action="ObtenerReservas" asp-route-idHabitacion="@Model.IdHabitacion" class="btn btn-outline-success">Ver reservas</a>
                <a asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
