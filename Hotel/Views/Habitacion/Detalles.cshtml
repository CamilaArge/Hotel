@model Habitacion

@{
    ViewData["Title"] = "Detalles de habitación";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card ht-card shadow-sm">
            <div class="card-header">Detalles de la habitación</div>
            <div class="card-body p-4">
                <partial name="_DatosHabitacion" model="Model" />
            </div>
            <div class="card-footer bg-white">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                <a asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
