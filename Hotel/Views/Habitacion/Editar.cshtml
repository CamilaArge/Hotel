@model Habitacion

@{
    ViewData["Title"] = "Editar habitación";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card ht-card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-1">Editar habitación</h3>
                <p class="text-muted">@Model.CodigoDeHabitacion - @Model.NombreDeHabitacion (@Model.Ubicacion)</p>

                <partial name="_Mensajes" />

                <form asp-action="Editar" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* Estos campos no se editan, pero se envían para que el modelo sea válido *@
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CodigoDeHabitacion" />
                    <input type="hidden" asp-for="NombreDeHabitacion" />
                    <input type="hidden" asp-for="CantidadDeBanos" />
                    <input type="hidden" asp-for="Ubicacion" />
                    <input type="hidden" asp-for="FechaDeRegistro" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CantidadDeHuespedesPermitidos" class="form-label"></label>
                            <input asp-for="CantidadDeHuespedesPermitidos" class="form-control" />
                            <span asp-validation-for="CantidadDeHuespedesPermitidos" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CantidadDeCamas" class="form-label"></label>
                            <input asp-for="CantidadDeCamas" class="form-control" />
                            <span asp-validation-for="CantidadDeCamas" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="EncargadoDeLimpieza" class="form-label"></label>
                            <input asp-for="EncargadoDeLimpieza" class="form-control" />
                            <span asp-validation-for="EncargadoDeLimpieza" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="TipoDeHabitacion" class="form-label"></label>
                            <select asp-for="TipoDeHabitacion" class="form-select">
                                <option value="0">Seleccione tipo</option>
                                <option value="1">Junior</option>
                                <option value="2">Superior</option>
                                <option value="3">Suite</option>
                            </select>
                            <span asp-validation-for="TipoDeHabitacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CostoDeLimpieza" class="form-label"></label>
                            <input asp-for="CostoDeLimpieza" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="CostoDeLimpieza" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CostoDeReserva" class="form-label"></label>
                            <input asp-for="CostoDeReserva" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="CostoDeReserva" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Estado" class="form-check-input" />
                        <label asp-for="Estado" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-warning">Guardar cambios</button>
                    <a asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
