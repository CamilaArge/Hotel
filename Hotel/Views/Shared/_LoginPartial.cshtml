@* Parte derecha del menú: saludo y cerrar sesión, o registrarse e iniciar sesión *@
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-white-50">Hola @User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="LogOff" method="post" class="d-inline">
                <button type="submit" class="nav-link btn btn-link">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Register">Registrarse</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        </li>
    }
</ul>
