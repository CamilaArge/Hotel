@model Reserva


<dl class="row mb-0">
    <dt class="col-sm-4">Número de reservación</dt>
    <dd class="col-sm-8">#@Model.IdReserva</dd>

    <dt class="col-sm-4">Huésped</dt>
    <dd class="col-sm-8">@Model.HuespedTexto</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IdHabitacion)</dt>
    <dd class="col-sm-8">@Model.HabitacionTexto</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IdPaquete)</dt>
    <dd class="col-sm-8">@Model.PaqueteTexto</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaEntrada)</dt>
    <dd class="col-sm-8">@Model.FechaEntrada.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaSalida)</dt>
    <dd class="col-sm-8">@Model.FechaSalida.ToString("dd/MM/yyyy")</dd>

    <dt class="col-sm-4">Noches</dt>
    <dd class="col-sm-8">@Model.Noches</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CantidadPersonas)</dt>
    <dd class="col-sm-8">@Model.CantidadPersonas</dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.MontoTotal)</dt>
    <dd class="col-sm-8 fw-bold">@Model.MontoTotal.Colones()</dd>

    <dt class="col-sm-4">Total pagado</dt>
    <dd class="col-sm-8">@Model.TotalPagado.Colones()</dd>

    <dt class="col-sm-4">Saldo pendiente</dt>
    <dd class="col-sm-8">@Model.Saldo.Colones() <partial name="_EstadoReserva" model="Model.EstadoPagoTexto" /></dd>

    <dt class="col-sm-4">Estado</dt>
    <dd class="col-sm-8"><partial name="_EstadoReserva" model="Model.EstadoTexto" /></dd>

    <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaRegistro)</dt>
    <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>
