@model List<Habitacion>

@{
    ViewData["Title"] = "Habitaciones disponibles";
}

<h3 class="mb-3">Habitaciones disponibles</h3>

<partial name="_Mensajes" />

<div class="card ht-card shadow-sm mb-4">
    <div class="card-body">
        <label for="idReservacion" class="form-label">¿Ya tiene una reserva? Búsquela por su número</label>
        <div class="input-group" style="max-width: 420px;">
            <input type="number" id="idReservacion" class="form-control" placeholder="Número de reservación" />
            <button id="btnBuscarReserva" type="button" class="btn btn-primary">Buscar</button>
        </div>
        <div id="mensajeBusqueda" class="text-danger mt-2"></div>
    </div>
</div>

<div class="card ht-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Huéspedes</th>
                        <th>Camas</th>
                        <th>Baños</th>
                        <th>Ubicación</th>
                        <th>Tipo</th>
                        <th>Costo por noche</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No hay habitaciones disponibles.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NombreDeHabitacion</td>
                            <td>@item.CantidadHuespedesPermitidos</td>
                            <td>@item.CantidadCamas</td>
                            <td>@item.CantidadDeBanos</td>
                            <td>@item.Ubicacion</td>
                            <td>@item.TipoTexto</td>
                            <td>@item.CostoDeReserva.ToString("N2")</td>
                            <td>
                                <a asp-action="AgregarReserva" asp-route-idHabitacion="@item.Id" class="btn btn-success btn-sm">Reservar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal con el detalle de la reserva buscada -->
<div class="modal fade" id="modalReserva" tabindex="-1" aria-labelledby="modalReservaTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalReservaTitulo">Detalle de la reserva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reserva.js" asp-append-version="true"></script>
}
