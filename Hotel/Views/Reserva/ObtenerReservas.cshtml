@model List<Reserva>

@{
    ViewData["Title"] = "Reservas";
    var habitacion = ViewBag.Habitacion as Habitacion;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Reservas de @habitacion?.NombreDeHabitacion</h3>
    <a asp-controller="Habitacion" asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver a habitaciones</a>
</div>

<partial name="_Mensajes" />

<div class="card ht-card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Monto total</th>
                        <th>Registro</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">Esta habitación no tiene reservas.</td>
                        </tr>
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FechaInicioReserva.ToString("dd/MM/yyyy")</td>
                            <td>@item.FechaFinReserva.ToString("dd/MM/yyyy")</td>
                            <td>@item.MontoTotal.ToString("N2")</td>
                            <td>@item.FechaDeRegistro.ToString("dd/MM/yyyy")</td>
                            <td class="text-nowrap">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
