@model List<Reserva>

@{
    ViewData["Title"] = "Reservas de la habitación";
    var habitacion = ViewBag.Habitacion as Habitacion;
    ViewData["MostrarHabitacion"] = false;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Reservas de @habitacion?.Codigo - @habitacion?.Nombre</h3>
    <div class="d-flex gap-2">
        <a asp-action="AgregarReserva" asp-route-idHabitacion="@habitacion?.IdHabitacion" class="btn btn-success">+ Reservar esta habitación</a>
        <a asp-controller="Habitacion" asp-action="ObtenerHabitaciones" class="btn btn-outline-secondary">Volver a habitaciones</a>
    </div>
</div>

<partial name="_Mensajes" />

<partial name="_TablaReservas" model="Model" view-data="ViewData" />
