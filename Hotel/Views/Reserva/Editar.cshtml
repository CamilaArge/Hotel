@model Reserva

@{
    ViewData["Title"] = "Editar reserva";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card ht-card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-1">Editar reserva #@Model.IdReserva</h3>
                <p class="text-muted">
                    Huésped: <strong>@Model.HuespedTexto</strong> ·
                    Monto actual: @Model.MontoTotal.Colones() ·
                    Pagado: @Model.TotalPagado.Colones()
                </p>
                <p class="small text-muted">
                    Si cambia la habitación, las fechas o el paquete, el monto se recalcula con las tarifas actuales.
                    Si solo cambia la cantidad de personas, se conserva el monto.
                </p>

                <partial name="_Mensajes" />

                <form asp-action="Editar" method="post" id="formReserva">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="IdReserva" />
                    <input type="hidden" asp-for="FechaRegistro" />

                    <partial name="_FormularioReserva" model="Model" />

                    <button type="submit" class="btn btn-warning">Guardar cambios</button>
                    <a asp-action="Detalles" asp-route-id="@Model.IdReserva" class="btn btn-outline-secondary">Volver</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reserva.js" asp-append-version="true"></script>
}
